# Copy to .env and set real values for local development. Never commit .env.
# Para conexão com pooler (Supabase pgbouncer/transaction pooler), configure connection_limit=10
# para permitir consultas paralelas durante a renderização SSR do Next.js sem esgotar o pool.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"

# Segredo opcional para proteger a rota /api/health contra abuso de chamadas públicas
HEALTH_CHECK_SECRET=""

