# Copy to .env and set real values for local development. Never commit .env.
# Para conexão com pooler (Supabase pgbouncer/transaction pooler), configure connection_limit=10
# para permitir consultas paralelas durante a renderização SSR do Next.js sem esgotar o pool.
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-unique-random-secret"

# Segredo opcional para proteger a rota /api/health contra abuso de chamadas públicas
HEALTH_CHECK_SECRET=""

# Optional production photo storage. When configured, uploads use Supabase Storage.
# Create a public bucket named property-photos before enabling these variables.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="property-photos"

# E-mail (Resend) — https://resend.com
# Obrigatório para o formulário de contato funcionar.
# Crie uma conta em resend.com, verifique o domínio corretoraval.com.br e copie a API Key.
RESEND_API_KEY=""
# Remetente: use "Corretora Val <noreply@corretoraval.com.br>" após verificar o domínio.
# Antes da verificação, use "Corretora Val <onboarding@resend.dev>" (sandbox).
EMAIL_FROM="Corretora Val <onboarding@resend.dev>"
