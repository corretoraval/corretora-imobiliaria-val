generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Finalidade {
  VENDA
  LOCACAO_ANUAL
  TEMPORADA
}

enum StatusImovel {
  DISPONIVEL
  RESERVADO
  EM_NEGOCIACAO
  ALUGADO
  VENDIDO
  INDISPONIVEL
  ARQUIVADO
}

enum VisibilidadeEndereco {
  EXATA
  APROXIMADA
}

enum StatusDocumentacao {
  REGULAR
  EM_ANDAMENTO
  PENDENTE
}

enum MarcadorImovel {
  DESTAQUE
  LANCAMENTO
  OPORTUNIDADE
  EXCLUSIVIDADE
  ALTO_PADRAO
  FRENTE_MAR
  QUADRA_MAR
  ESTUDANTE
  PET_FRIENDLY
}

model Imovel {
  id                    String               @id @default(cuid())
  code                  String               @unique
  slug                  String               @unique
  title                 String
  summary               String?
  description           String?
  propertyType          String
  purpose               Finalidade
  status                StatusImovel         @default(DISPONIVEL)
  documentationStatus   StatusDocumentacao   @default(REGULAR)
  city                  String
  neighborhood          String?
  address               String?
  postalCode            String?
  addressVisibility     VisibilidadeEndereco @default(APROXIMADA)
  latitude              Decimal?             @db.Decimal(10, 7)
  longitude             Decimal?             @db.Decimal(10, 7)
  salePrice             Int?
  monthlyRent           Int?
  condoFee              Int?
  iptu                  Int?
  waterFee              Int?
  gasFee                Int?
  garbageFee            Int?
  otherFees             Int?
  dailyRate             Int?
  packageRate           Int?
  cleaningFee           Int?
  securityDeposit       Int?
  bedrooms              Int?
  suites                Int?
  bathrooms             Int?
  halfBathrooms         Int?
  parkingSpaces         Int?
  privateArea           Int?
  totalArea             Int?
  floor                 Int?
  hasElevator           Boolean              @default(false)
  hasBalcony            Boolean              @default(false)
  hasBarbecue           Boolean              @default(false)
  hasPool               Boolean              @default(false)
  furnished             Boolean              @default(false)
  hasAirConditioning    Boolean              @default(false)
  allowsPets            Boolean              @default(false)
  hasWifi               Boolean              @default(false)
  seaView               Boolean              @default(false)
  oceanFront            Boolean              @default(false)
  beachBlock            Boolean              @default(false)
  videoUrl              String?
  isFeatured            Boolean              @default(false)
  markers               MarcadorImovel[]
  internalDocumentsNote String?
  archivedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  photos                Foto[]
  contratos             Contrato[]

  @@index([purpose, status])
  @@index([city, neighborhood])
  @@index([isFeatured])
}

model Usuario {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  password           String
  role               String     @default("user")
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  contratos          Contrato[]
}

model Contrato {
  id        String    @id @default(cuid())
  imovelId  String
  usuarioId String
  startAt   DateTime
  endAt     DateTime?
  value     Int

  imovel  Imovel  @relation(fields: [imovelId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
}

model Foto {
  id       String  @id @default(cuid())
  url      String
  alt      String?
  position Int     @default(0)
  isCover  Boolean @default(false)
  imovelId String
  imovel   Imovel  @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@index([imovelId, position])
}

model ConfiguracaoSite {
  id               String   @id @default("principal")
  brandName        String   @default("Corretora Val")
  tagline          String   @default("Confiança que abre portas.")
  phone            String?
  whatsapp         String?
  email            String?
  address          String?
  instagramUrl     String?
  creci            String   @default("CRECI/SC 56372-F")
  // Tema visual
  themePreset      String   @default("ametista-ouro")
  primaryColor     String   @default("#35104f")
  primaryHover     String   @default("#4a1768")
  accentColor      String   @default("#b58a3a")
  accentLightColor String   @default("#d8bd82")
  backgroundColor  String   @default("#f8f5ef")
  titleFont        String   @default("cormorant")
  bodyFont         String   @default("manrope")
  updatedAt        DateTime @updatedAt
}

model PaginaSite {
  id              String   @id @default(cuid())
  slug            String   @unique
  navigationLabel String
  eyebrow         String?
  title           String
  heading         String
  intro           String?
  body            String?
  ctaLabel        String?
  ctaHref         String?
  seoTitle        String?
  seoDescription  String?
  content         Json?
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

enum TipoLead {
  ANUNCIAR
  ALUGAR
  COMPRAR
  CONTATO
}

enum StatusLead {
  NOVO
  EM_ATENDIMENTO
  CONCLUIDO
  ARQUIVADO
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String
  phone           String
  type            TipoLead   @default(CONTATO)
  subject         String?
  message         String?
  propertyAddress String?
  propertyType    String?
  status          StatusLead @default(NOVO)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([type, status])
}

model PostBlog {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  summary            String
  content            String   @db.Text
  category           String
  coverImage         String?
  authorName         String   @default("Corretora Val")
  readingTimeMinutes Int      @default(5)
  isFeatured         Boolean  @default(false)
  isPublished        Boolean  @default(true)
  publishedAt        DateTime @default(now())
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([title])
  @@index([summary])
  @@index([isPublished, category])
  @@index([isFeatured])
}

model Depoimento {
  id          String   @id @default(cuid())
  clientName  String
  text        String
  role        String?
  avatarUrl   String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model MarcoHistorico {
  id          String   @id @default(cuid())
  year        Int
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model MembroEquipe {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  photoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}
